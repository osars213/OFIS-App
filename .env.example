# ==============================================================================
# OFIS 2.0 Environment Configuration
# ==============================================================================

# Client-Side (Vite) Environment Variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Environment Variables (Confidential - never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# SZND Payment Gateway Environment Configuration
# Options for SZND_ENV: 'test' | 'production'
#
# TEST CONFIGURATION:
# SZND_ENV=test
# SZND_API_KEY=<SZND_TEST_KEY>
# SZND_API_SECRET=<SZND_TEST_SECRET>
# SZND_API_BASE_URL=<SZND_TEST_API_BASE_URL>
#
# PRODUCTION CONFIGURATION:
# SZND_ENV=production
# SZND_API_KEY=<SZND_LIVE_KEY>
# SZND_API_SECRET=<SZND_LIVE_SECRET>
# SZND_API_BASE_URL=<SZND_LIVE_API_BASE_URL>

SZND_ENV=production
SZND_API_KEY=
SZND_API_SECRET=
SZND_API_BASE_URL=

GEMINI_API_KEY=
APP_URL=

