# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and anon public API key.
# When provided, OFIS connects to your Supabase PostgreSQL database for real-time listings,
# authentication, bookings, and space synchronization.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SERVER-SIDE ONLY SECRETS (Never prefix with VITE_ and never expose to browser):
# SUPABASE_SERVICE_ROLE_KEY: Required on server for privileged payment confirmation RPC execution
SUPABASE_SERVICE_ROLE_KEY=""

# PAYSTACK CONFIGURATION:
# Paystack API keys for Nigerian Naira (NGN) card, bank transfer, and USSD payments
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""
